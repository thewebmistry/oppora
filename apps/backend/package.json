{
  "name": "company-intelligence-platform-backend",
  "version": "1.0.0",
  "description": "Backend for Company Intelligence Platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec \"ts-node -r tsconfig-paths/register\" src/server.ts",
    "build": "tsc",
    "prestart": "npm run build",
    "start": "node dist/server.js",
    "prod": "NODE_ENV=production npm start",
    "lint": "eslint src --ext .ts",
    "test": "jest",
    "deploy": "npm run build && pm2 start ecosystem.config.js --env production",
    "db:seed": "tsx src/utils/seedDatabase.ts",
    "db:seed:clear": "tsx src/utils/seedDatabase.ts --clear"
  },
  "keywords": [
    "node",
    "express",
    "typescript",
    "mongoose"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.4.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.8.0",
    "morgan": "^1.10.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/mongoose": "^5.11.96",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.6",
    "@types/socket.io": "^3.0.1",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
