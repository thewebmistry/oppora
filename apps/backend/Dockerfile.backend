# Dockerfile for Company Intelligence Platform Backend
# Multi-stage build for production optimization

# Stage 1: Builder - Install dependencies and build TypeScript
FROM node:18-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY tsconfig.json ./

# Install dependencies (including dev dependencies for build)
RUN npm ci --only=production --ignore-scripts
RUN npm ci --only=development --ignore-scripts

# Copy source code
COPY src ./src
COPY ecosystem.config.js ./

# Build TypeScript to JavaScript
RUN npm run build

# Remove dev dependencies after build
RUN npm prune --production

# Stage 2: Runner - Minimal production image
FROM node:18-alpine AS runner

WORKDIR /app

# Create non-root user for security
RUN addgroup -g 1001 -S nodejs
RUN adduser -S nodejs -u 1001

# Copy built artifacts and production dependencies from builder
COPY --from=builder --chown=nodejs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nodejs:nodejs /app/dist ./dist
COPY --from=builder --chown=nodejs:nodejs /app/ecosystem.config.js ./
COPY --from=builder --chown=nodejs:nodejs /app/package.json ./

# Copy environment file (if exists) - override in production with docker secrets
COPY --chown=nodejs:nodejs .env.example .env

# Switch to non-root user
USER nodejs

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "require('http').get('http://localhost:5000/api/health', (r) => {if(r.statusCode!==200)throw new Error()})"

# Expose port
EXPOSE 5000

# Start the application
CMD ["npm", "start"]

# Optional: Use PM2 for process management (uncomment if needed)
# CMD ["npx", "pm2-runtime", "start", "ecosystem.config.js", "--env", "production"]